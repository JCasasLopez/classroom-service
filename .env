##############################################################################
# This is a demo project, so it is acceptable to have the secret key and
# credentials committed in this .env file, publicly visible in the repository.
# In a real production environment, these values would be managed through a
# secret manager (e.g. Vault, AWS Secrets Manager) and this file would never
# be committed to version control.
##############################################################################

# Environment variables (topics are shared among different micro-services)
JWT_SECRETKEY=MTIzNDU2Nzg5MEFCQ0RFRkdISUpLTE1OT1BRUlNUVVZXWFlaMDEyMzQ1Njc4OTA=
FRONTEND_URL=http://localhost:4200

# Database-ralated
DB_ROOT_USERNAME=root
DB_ROOT_PASSWORD=password123

# Kafka-related
KAFKA_TOPIC_CLASSROOMS=classrooms
KAFKA_NUMBER_REPLICAS=1
KAFKA_NUMBER_IN_SYNC_REPLICAS=1